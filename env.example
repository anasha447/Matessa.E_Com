# Copy to ".env" and replace every CHANGE_ME. .env is gitignored and must NEVER be committed.
# docker compose refuses to start while a required value below is missing.
#
# Generate strong values with:  openssl rand -base64 24

# ---- Postgres: one server, three databases (one role each) ----
# USERS_DB_USER is also the server's bootstrap superuser (it owns the `users` DB).
# The other two roles + databases are created on first boot by backend/db-init/.
USERS_DB_USER=users_app
USERS_DB_PASSWORD=CHANGE_ME
COMMERCIAL_DB_USER=matessa_commercial
COMMERCIAL_DB_PASSWORD=CHANGE_ME
ORDERS_DB_USER=matessa_order
ORDERS_DB_PASSWORD=CHANGE_ME

# ---- Stores ----
# Each id is a separate store with its own schema in every service DB: its own products,
# customers, orders, coupons and admins. Ids: lowercase letters, digits, underscore.
APP_TENANCY_TENANTS=matessa,adventure

# ---- Initial admin per store ----
# Seeded by user-service on boot if that email does not exist yet in that store.
# Changing the password here later does NOT change an existing admin's password.
MATESSA_ADMIN_EMAIL=admin@matessa.com
MATESSA_ADMIN_PASSWORD=CHANGE_ME
ADVENTURE_ADMIN_EMAIL=admin@adventuredose.com
ADVENTURE_ADMIN_PASSWORD=CHANGE_ME

# ---- pgAdmin (local tool only: docker compose --profile tools up -d pgadmin) ----
PGADMIN_EMAIL=admin@matessa.com
PGADMIN_PASSWORD=CHANGE_ME

# ---- Gateway CORS: the storefront origins ----
# Production: your two https domains, e.g. https://matessa.in,https://adventuredose.in
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:3000

# ---- JWT keys (not env vars) ----
# RS256 keys live in ./keys/ (gitignored) and are mounted read-only. Generate per environment:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out keys/jwt-private.pem
#   openssl rsa -in keys/jwt-private.pem -pubout -out keys/jwt-public.pem
# Only user-service gets the private key; every other service gets the public key only.
