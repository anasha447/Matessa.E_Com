# Copy this file to ".env" and fill in real values.
# .env is gitignored and must NEVER be committed.

# ---- Databases -------------------------------------------------------------
# One Postgres container ("matessa-db") hosts three databases — users,
# commercial, orders — each owned by its own role, so the
# database-per-service boundary holds without running three servers.
# The roles and databases are created from these vars on the container's
# FIRST boot only (see backend/db-init/init-multi-db.sh); changing them later
# requires recreating the matessa-db-data volume.
#
# USERS_DB_* is also the bootstrap superuser that owns the `users` database.
USERS_DB_USER=matessa_user
USERS_DB_PASSWORD=change_me_strong_password

COMMERCIAL_DB_USER=matessa_commercial
COMMERCIAL_DB_PASSWORD=change_me_strong_password

ORDERS_DB_USER=matessa_order
ORDERS_DB_PASSWORD=change_me_strong_password

# ---- Initial admin ---------------------------------------------------------
# user-service seeds this account on first boot if ADMIN_PASSWORD is set.
# Leave ADMIN_PASSWORD blank to skip seeding — no default password is shipped.
ADMIN_EMAIL=admin@matessa.com
ADMIN_PASSWORD=change_me_admin_password

# ---- Gateway ---------------------------------------------------------------
# Browser origins allowed to call the gateway, comma-separated. Defaults cover
# local dev for both storefronts; set the real hostnames in production.
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:3000

# ---- RS256 JWT keys --------------------------------------------------------
# Not configured here: the key PAIR lives in ./keys (gitignored) and is mounted
# read-only into the containers. Only user-service gets the private key; the
# gateway and the other services receive the public key only. Generate with:
#   openssl genpkey -algorithm RSA -out keys/jwt-private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -pubout -in keys/jwt-private.pem -out keys/jwt-public.pem
